# PTA CD database connection — copy to `.env` and fill in.
# A template for scripted/one-shot setups; most machines configure the server
# once from the title-bar dialog instead (that setting is remembered per machine).
#
#   Windows (installed app): place this file as `.env` NEXT TO the PTA CD exe
#   Dev / npm:              place it at the project root (next to package.json)
#
# All values are optional — omitted ones fall back to the built-in defaults.

# LAN IP (or hostname) of the machine running MySQL / TapIn School
DB_HOST=192.168.1.129

# MySQL port (default 3306)
DB_PORT=3306

# Dedicated network account created on the server — see scripts/grant-mysql-access.sql.
# Do NOT use root.
DB_USER=pta

# Password for the account above — matches scripts/grant-mysql-access.sql
# (keep it out of the repo — .env is gitignored)
DB_PASSWORD=joel

# The shared database TapIn School uses (do not change unless TapIn uses another name)
DB_NAME=tapin_school

# Max pooled connections per machine (1–50). Keep small: several PTA machines
# plus TapIn School share one MySQL (default max_connections is 151).
DB_POOL=5
