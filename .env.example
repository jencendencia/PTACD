# Copy this file to `.env` and fill in real values.
# PTA CD loads `.env` automatically on startup (see electron/db/env.ts).
# Real OS environment variables (DB_HOST, DB_USER, ...) take precedence.

# Same computer as MySQL (local dev):
#   DB_HOST=127.0.0.1
# Another computer connecting to MySQL over the network:
#   DB_HOST=<LAN IP or hostname of the computer running MySQL>
#   e.g. DB_HOST=192.168.1.129   (find it with `ipconfig` on the server)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pta
DB_PASSWORD=change-me
DB_NAME=tapin_school
